# xiaoan-platform — Go backend configuration
# Copy to .env.development.local (git-ignored) and fill in real secrets.
# Real secrets must NEVER be committed.

# Select the file profile before startup with STUDIO_ENV=dev|test|prod.
# APP_ENV controls runtime behavior and may also be supplied by the process.
# development | production | test
APP_ENV=development
LOG_LEVEL=info

# Process addresses
# studio-api  (short requests)
API_ADDR=:8080
# studio-stream (SSE long connections)
STREAM_ADDR=:8081
METRICS_ADDR=:9090
PPROF_ENABLED=false

# ── Database: MySQL 5.7 (the only supported baseline). ──
# The Go backend uses its OWN clean database, xiaoan. One-time bootstrap
# (the runtime account may lack CREATE DATABASE):
#   as admin: CREATE DATABASE xiaoan CHARACTER SET utf8mb4 COLLATE utf8mb4_bin;
#   GRANT ALL PRIVILEGES ON xiaoan.* TO 'potal_app'@'%';
# The schema is owned by db/migrations — never import a dump's CREATE TABLE
# output over it.
DB_HOST=192.168.211.26
DB_PORT=3306
DB_NAME=xiaoan
DB_USER=potal_app
DB_PASSWORD=replace-me

DB_MAX_OPEN_CONNS=40
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME=30m
DB_CONN_MAX_IDLE_TIME=5m
DB_QUERY_TIMEOUT=15s

# ── Redis: standalone in dev/test; cluster in production ──
REDIS_MODE=standalone
# Standalone topology
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DATABASE=0
# Shared authentication / namespacing
REDIS_PASSWORD=replace-me
REDIS_KEY_PREFIX=xiaoan3
# Cluster topology (required only when REDIS_MODE=cluster; Redis Cluster requires DB 0)
REDIS_CLUSTER_NODES=
REDIS_CLUSTER_MAX_REDIRECTS=3
# Connection pool and timeouts (pool size is per node in cluster mode)
REDIS_CONNECT_TIMEOUT=10s
REDIS_TIMEOUT=5s
REDIS_POOL_TIMEOUT=3s
REDIS_POOL_SIZE=20
REDIS_MIN_IDLE_CONNS=5
REDIS_MAX_IDLE_CONNS=10

# ── Feishu / Aily (secrets from environment only) ──
FEISHU_APP_ID=replace-me
FEISHU_APP_SECRET=replace-me
FEISHU_REDIRECT_URI=http://localhost:3030/auth/feishu/callback
FEISHU_BASE_URL=https://open.feishu.cn
# Enterprise ACL rollout: keep false until the first successful full directory sync is validated.
ENTERPRISE_ACL_ENABLED=false
ENTERPRISE_RBAC_ENABLED=false
AILY_BASE_URL=https://open.feishu.cn/open-apis
# official chats limit: 10/s
AILY_START_RATE_LIMIT=10
# Legacy compatibility only; execution capacity comes from providers.max_inflight.
# Missing/unreadable catalog policy fails closed; this is NOT an override.
AILY_MAX_INFLIGHT=100
AILY_POLL_BACKOFF_SECONDS=1,2,3,5
AILY_STREAM_TIMEOUT=330s
AILY_REQUEST_TIMEOUT=30s

# ── Execution plane ──
RUN_LEASE_SECONDS=120s
RUN_LEASE_HEARTBEAT_SECONDS=30s
RUN_CLAIM_BATCH_SIZE=10
RUN_REAPER_INTERVAL=20s
OUTBOX_RELAY_INTERVAL=500ms
WORKER_CONCURRENCY=10
# WORKER_ID= (defaults to hostname-pid)

# ── Session / auth ──
SESSION_TTL=12h
SESSION_COOKIE_NAME=studio_session
CSRF_COOKIE_NAME=studio_csrf
# Immediate reverse-proxy CIDRs allowed to supply X-Real-IP.
TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128,172.16.0.0/12
# AES-256-GCM key material for Feishu refresh tokens at rest
TOKEN_ENCRYPTION_KEY=replace-me
ADMIN_BOOTSTRAP_USERNAME=admin
ADMIN_BOOTSTRAP_PASSWORD=

# ── Storage (attachments / avatars / mirrored artifacts) ──
# localfs | s3
STORAGE_DRIVER=localfs
STORAGE_LOCAL_ROOT=./data/storage
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_USE_SSL=true

# ── AI model egress ──
# Exact host allowlist for private/local model endpoints. No wildcards.
# Required by the built-in GLM-4.6V-FlashX HTTP preset:
# AI_MODEL_ALLOWED_HOSTS=192.168.212.121

# ── Observability ──
# empty = local spans only
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=studio-backend
OTEL_SAMPLING_RATE=0.1

# Browser-reachable website URL used in automatic Feishu result cards.
# Set to the real HTTPS site URL in deployments; recipients must reach it.
PUBLIC_BASE_URL=http://localhost:3030

# Public deployment: basePath comes from ../deployment.json (shared with frontend).
# Set the browser-reachable origin only; callback/share URLs append basePath automatically.
PUBLIC_ORIGIN=http://localhost:3030
# Packaged deployments: mount deployment.json and set its absolute path.
# DEPLOYMENT_CONFIG=/etc/studio/deployment.json
# Optional override; MUST match the frontend build's APP_BASE_PATH. Use / for root.
# APP_BASE_PATH=/xiaoan-platform/
# Legacy PUBLIC_BASE_URL / FEISHU_REDIRECT_URI contribute only the origin when
# PUBLIC_ORIGIN is absent; their path portions are replaced by configured basePath.
