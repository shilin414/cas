# Context: backend-go/. No credentials or mutable data enter the image.
ARG GO_IMAGE=golang:1.27.1-alpine
ARG RUNTIME_IMAGE=alpine:3.22
FROM ${GO_IMAGE} AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY cmd/ ./cmd/
COPY internal/ ./internal/
RUN CGO_ENABLED=0 go build -trimpath -o /out/api ./cmd/api && \
    CGO_ENABLED=0 go build -trimpath -o /out/stream ./cmd/stream && \
    CGO_ENABLED=0 go build -trimpath -o /out/worker ./cmd/worker && \
    CGO_ENABLED=0 go build -trimpath -o /out/scheduler ./cmd/scheduler && \
    CGO_ENABLED=0 go build -trimpath -o /out/migrate ./cmd/migrate
FROM ${RUNTIME_IMAGE}
RUN apk add --no-cache ca-certificates tzdata && \
    addgroup -g 10001 studio && adduser -D -u 10001 -G studio studio && \
    mkdir -p /app/data/storage && chown -R 10001:10001 /app
WORKDIR /app
COPY --from=build /out/ /usr/local/bin/
COPY db/migrations/ /app/db/migrations/
ENV APP_BASE_PATH=/xiaoan-platform/ STORAGE_LOCAL_ROOT=/app/data/storage
USER 10001:10001
# No migration flag, entrypoint script or automatic SQL execution.
CMD ["api"]
