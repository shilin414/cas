# Review all values before deployment. This file contains placeholders, not secrets.
# Same contents for all backend roles. Plain KEY=value, no quotes or inline comments.
STUDIO_ENV=prod
APP_ENV=production
LOG_LEVEL=info
APP_BASE_PATH=/xiaoan-platform/
PUBLIC_ORIGIN=https://REPLACE_APP_DOMAIN
API_ADDR=:8080
STREAM_ADDR=:8081
DB_HOST=192.168.212.165
DB_PORT=23306
DB_NAME=xiaoan
DB_USER=REPLACE_RUNTIME_USER
DB_PASSWORD=REPLACE_DB_PASSWORD
DB_MAX_OPEN_CONNS=20
DB_MAX_IDLE_CONNS=5
REDIS_MODE=cluster
REDIS_DATABASE=0
REDIS_CLUSTER_NODES=192.168.212.165:6381,192.168.212.165:6382,192.168.212.165:6383
REDIS_CLUSTER_MAX_REDIRECTS=3
REDIS_PASSWORD=REPLACE_REDIS_PASSWORD
REDIS_KEY_PREFIX=xiaoan-prod
REDIS_POOL_SIZE=20
REDIS_MIN_IDLE_CONNS=5
REDIS_MAX_IDLE_CONNS=10
REDIS_CONNECT_TIMEOUT=10s
REDIS_TIMEOUT=5s
REDIS_POOL_TIMEOUT=3s
FEISHU_APP_ID=REPLACE_FEISHU_APP_ID
FEISHU_APP_SECRET=REPLACE_FEISHU_APP_SECRET
