// xiaoan-platform FRONTEND pipeline — TEST environment, hard-wired.
// One pipeline file per environment (Jenkinsfile.frontend for prod);
// the Jenkins job picks its environment by its Script Path, no parameters
// to choose from.
//
// Flow: GitLab(test branch) → Node 22 build (nodedkbuild node22140) →
// docker build xiaoan-ui → Harbor(eboat2) → set image on xiaoan-ui-test
// (test-ai-ns) → rollout check.
//
// TEST values baked in: namespace test-ai-ns, Deployment xiaoan-ui-test,
// Nginx upstreams xiaoan-api-test:8080 / xiaoan-stream-test:8081,
// tag prefix test-. Test and prod xiaoan-ui images are NOT interchangeable
// (upstreams differ); rollback only ever to a test- tag.
//
// NEVER touches backend Deployments or the database.
//
// OCR note: the build's prebuild hook downloads a 6.1 MB OCR model
// (sha256-pinned). First run needs internet; afterwards
// frontend/public/ocr-assets/ppocrv6-tiny-20260921/ makes it fully offline.
// If the Jenkins host has no internet, copy that directory from any machine
// that built successfully once — the build fails closed without it.

pipeline {
    agent any

    // SKIP_DEPLOY=true: build & push image only, do not touch K8s.
    parameters {
        booleanParam(name: 'SKIP_DEPLOY', defaultValue: false, description: '只构建并推送镜像，不更新 K8s')
    }

    environment {
        HARBOR          = 'harbor.hengan.com:8086'
        HARBOR_PROJECT  = 'eboat2'
        NAMESPACE       = 'test-ai-ns'
        DEPLOYMENT      = 'xiaoan-ui-test'
        TAG_PREFIX      = 'test'
        GIT_CREDENTIAL_ID = 'xiaoan-gitlab-http'
    }

    stages {

        stage('下载代码') {
            steps {
                git branch: 'test',
                    credentialsId: "${GIT_CREDENTIAL_ID}",
                    url: 'http://192.168.0.81/ai_sys/xiaoan-platform.git'
            }
        }

        stage('准备版本号') {
            steps {
                script {
                    env.GIT_SHORT_SHA = sh(
                        script: 'git rev-parse --short=8 HEAD',
                        returnStdout: true
                    ).trim()

                    env.IMAGE_TAG = "${TAG_PREFIX}-${new Date().format('yyyyMMddHHmmss')}-${env.GIT_SHORT_SHA}"
                }
                echo "IMAGE_TAG=${env.IMAGE_TAG}"
            }
        }

        stage('编译前端') {
            steps {
                sh '''
                    source /etc/profile

                    # npm ci for reproducible installs
                    nodedkbuild "$WORKSPACE/frontend" \
                      "node22140" \
                      "npm ci"

                    nodedkbuild "$WORKSPACE/frontend" \
                      "node22140" \
                      "npm run build"

                    if [ ! -d "$WORKSPACE/frontend/dist" ]; then
                        echo "前端编译失败"
                        exit 1
                    fi

                    if [ ! -f "$WORKSPACE/frontend/nginx.generated.conf" ]; then
                        echo "nginx.generated.conf 未生成，部署脚本未执行"
                        exit 1
                    fi
                '''
            }
        }

        stage('生成 Nginx 配置') {
            steps {
                sh '''
                    # nodedkbuild runs commands inside its own Node container and
                    # does NOT propagate this shell's exported env vars, so the
                    # in-build deployment.mjs run sees neither APP_BASE_PATH nor
                    # the NGINX_* upstreams and falls back to the dev defaults
                    # ("api"/"stream"). Regenerate the conf here, on the Jenkins
                    # host, where the environment is under our control.
                    cd "$WORKSPACE/frontend"
                    export APP_BASE_PATH=/xiaoan-platform/
                    export NGINX_API_UPSTREAM=xiaoan-api-test:8080
                    export NGINX_STREAM_UPSTREAM=xiaoan-stream-test:8081
                    node scripts/deployment.mjs

                    # Fail closed: the conf must carry the TEST upstreams before
                    # it gets baked into the image.
                    grep -q "xiaoan-api-test:8080" nginx.generated.conf \\
                      || { echo "nginx.generated.conf 缺少测试环境 upstream"; exit 1; }
                    grep -q "xiaoan-stream-test:8081" nginx.generated.conf \\
                      || { echo "nginx.generated.conf 缺少测试环境 stream upstream"; exit 1; }
                '''
            }
        }

        stage('构建前端镜像') {
            steps {
                sh '''
                    docker build \
                      -f frontend/Dockerfile \
                      -t ${HARBOR}/${HARBOR_PROJECT}/xiaoan-ui:${IMAGE_TAG} \
                      frontend
                '''
            }
        }

        stage('推送镜像') {
            steps {
                sh '''
                    docker push ${HARBOR}/${HARBOR_PROJECT}/xiaoan-ui:${IMAGE_TAG}
                '''
            }
        }

        stage('更新 K8s') {
            when { expression { return !params.SKIP_DEPLOY } }
            steps {
                sh '''
                    kubectl -n ${NAMESPACE} set image \
                      deployment/${DEPLOYMENT} \
                      ${DEPLOYMENT}=${HARBOR}/${HARBOR_PROJECT}/xiaoan-ui:${IMAGE_TAG}
                '''
            }
        }

        stage('检查发布状态') {
            when { expression { return !params.SKIP_DEPLOY } }
            steps {
                sh '''
                    kubectl rollout status deployment/${DEPLOYMENT} -n ${NAMESPACE} --timeout=180s
                '''
            }
        }
    }
}
