// xiaoan-platform FRONTEND pipeline — PROD environment, hard-wired.
// One pipeline file per environment (Jenkinsfile.frontend-test for test);
// the Jenkins job picks its environment by its Script Path, no parameters
// to choose from — a prod job can never be misconfigured to test and
// vice versa.
//
// Flow: GitLab(test branch) → Node 22 build (nodedkbuild node22140) →
// docker build xiaoan-ui → Harbor(eboat2) → set image on xiaoan-ui
// (eboat-ai-ns) → rollout check.
//
// PROD values baked in: namespace eboat-ai-ns, Deployment xiaoan-ui,
// Nginx upstreams xiaoan-api:8080 / xiaoan-stream:8081, tag prefix prod-.
// → prod and test xiaoan-ui images are NOT interchangeable (upstreams
// differ); rollback only ever to a prod- tag.
//
// NEVER touches backend Deployments or the database.
//
// OCR note: the build's prebuild hook downloads a 6.1 MB OCR model
// (sha256-pinned). First run needs internet; afterwards
// frontend/public/ocr-assets/ppocrv6-tiny-20260921/ makes it fully offline.
// If the Jenkins host has no internet, copy that directory from any machine
// that built successfully once — the build fails closed without it.
//
// Release order when a change spans both ends: backend first (stays backward
// compatible), then frontend.

pipeline {
    agent any

    // SKIP_DEPLOY=true: build & push image only, do not touch K8s.
    // Used on FIRST run (workloads not applied yet) and for image-only rebuilds.
    parameters {
        booleanParam(name: 'SKIP_DEPLOY', defaultValue: false, description: '只构建并推送镜像，不更新 K8s')
    }

    environment {
        HARBOR          = 'harbor.hengan.com:8086'
        HARBOR_PROJECT  = 'eboat2'
        NAMESPACE       = 'eboat-ai-ns'
        DEPLOYMENT      = 'xiaoan-ui'
        TAG_PREFIX      = 'prod'
        GIT_CREDENTIAL_ID = 'xiaoan-gitlab-http'
    }

    stages {

        stage('下载代码') {
            steps {
                git branch: 'test',
                    credentialsId: "${GIT_CREDENTIAL_ID}",
                    url: 'http://192.168.0.81/ai_sys/xiaoan-platform.git'
            }
        }

        stage('准备版本号') {
            steps {
                script {
                    env.GIT_SHORT_SHA = sh(
                        script: 'git rev-parse --short=8 HEAD',
                        returnStdout: true
                    ).trim()

                    // Tag is independent of the backend pipeline's tag; rollback
                    // looks up prod- xiaoan-ui tags only.
                    env.IMAGE_TAG = "${TAG_PREFIX}-${new Date().format('yyyyMMddHHmmss')}-${env.GIT_SHORT_SHA}"
                }
                echo "IMAGE_TAG=${env.IMAGE_TAG}"
            }
        }

        stage('编译前端') {
            steps {
                sh '''
                    source /etc/profile

                    # npm ci for reproducible installs
                    nodedkbuild "$WORKSPACE/frontend" \
                      "node22140" \
                      "npm ci"

                    # nodedkbuild's command argument is executed as a single
                    # command name (no shell word-splitting) — env vars must be
                    # exported here so the npm child process inherits them.
                    export APP_BASE_PATH=/xiaoan-platform/
                    export NGINX_API_UPSTREAM=xiaoan-api:8080
                    export NGINX_STREAM_UPSTREAM=xiaoan-stream:8081

                    # Build with prod K8s upstream service names baked into
                    # nginx.generated.conf.
                    nodedkbuild "$WORKSPACE/frontend" \
                      "node22140" \
                      "npm run build"

                    if [ ! -d "$WORKSPACE/frontend/dist" ]; then
                        echo "前端编译失败"
                        exit 1
                    fi

                    if [ ! -f "$WORKSPACE/frontend/nginx.generated.conf" ]; then
                        echo "nginx.generated.conf 未生成，部署脚本未执行"
                        exit 1
                    fi
                '''
            }
        }

        stage('构建前端镜像') {
            steps {
                sh '''
                    docker build \
                      -f frontend/Dockerfile \
                      -t ${HARBOR}/${HARBOR_PROJECT}/xiaoan-ui:${IMAGE_TAG} \
                      frontend
                '''
            }
        }

        stage('推送镜像') {
            steps {
                sh '''
                    docker push ${HARBOR}/${HARBOR_PROJECT}/xiaoan-ui:${IMAGE_TAG}
                '''
            }
        }

        stage('更新 K8s') {
            when { expression { return !params.SKIP_DEPLOY } }
            steps {
                sh '''
                    kubectl -n ${NAMESPACE} set image \
                      deployment/${DEPLOYMENT} \
                      ${DEPLOYMENT}=${HARBOR}/${HARBOR_PROJECT}/xiaoan-ui:${IMAGE_TAG}
                '''
            }
        }

        stage('检查发布状态') {
            when { expression { return !params.SKIP_DEPLOY } }
            steps {
                sh '''
                    kubectl rollout status deployment/${DEPLOYMENT} -n ${NAMESPACE} --timeout=180s
                '''
            }
        }
    }
}
