// xiaoan-platform FRONTEND pipeline — Node build + xiaoan-ui image + ui Deployment.
// Split from Jenkinsfile.full (kept for one-shot full releases). The backend
// pipeline lives in Jenkinsfile.backend.
//
// Flow: GitLab(test branch) → Node 22 build (nodedkbuild node22140) →
// docker build xiaoan-ui → Harbor(eboat2) → set image on xiaoan-ui → rollout check.
//
// DEPLOY_ENV selects the K8s Deployment (k8s/prod/ vs k8s/test/ manifests, same
// namespace, -test-suffixed names) AND the Nginx upstreams baked into the image:
//   prod: xiaoan-api:8080 / xiaoan-stream:8081
//   test: xiaoan-api-test:8080 / xiaoan-stream-test:8081
// → one image per environment is required; tags are prefixed by environment.
//
// NEVER touches backend Deployments or the database.
//
// OCR note: the build's prebuild hook downloads a 6.1 MB OCR model
// (sha256-pinned). First run needs internet; afterwards
// frontend/public/ocr-assets/ppocrv6-tiny-20260921/ makes it fully offline.
// If the Jenkins host has no internet, copy that directory from any machine
// that built successfully once — the build fails closed without it.
//
// Release order when a change spans both ends: backend first (stays backward
// compatible), then frontend.

pipeline {
    agent any

    // SKIP_DEPLOY=true: build & push image only, do not touch K8s.
    parameters {
        booleanParam(name: 'SKIP_DEPLOY', defaultValue: false, description: '只构建并推送镜像，不更新 K8s')
        choice(name: 'DEPLOY_ENV', choices: ['prod', 'test'], description: '发布目标环境：prod=生产，test=测试（-test 后缀与对应 Nginx upstream）')
    }

    environment {
        HARBOR          = 'harbor.hengan.com:8086'
        HARBOR_PROJECT  = 'eboat2'
        NAMESPACE       = 'eboat-ai-ns'
        APP_BASE_PATH   = '/xiaoan-platform/'
        GIT_CREDENTIAL_ID = 'xiaoan-gitlab-http'
    }

    stages {

        stage('下载代码') {
            steps {
                git branch: 'test',
                    credentialsId: "${GIT_CREDENTIAL_ID}",
                    url: 'http://192.168.0.81/ai_sys/xiaoan-platform.git'
            }
        }

        stage('准备版本号') {
            steps {
                script {
                    env.SUFFIX = params.DEPLOY_ENV == 'test' ? '-test' : ''
                    env.API_UPSTREAM = params.DEPLOY_ENV == 'test' ? 'xiaoan-api-test:8080' : 'xiaoan-api:8080'
                    env.STREAM_UPSTREAM = params.DEPLOY_ENV == 'test' ? 'xiaoan-stream-test:8081' : 'xiaoan-stream:8081'
                    env.GIT_SHORT_SHA = sh(
                        script: 'git rev-parse --short=8 HEAD',
                        returnStdout: true
                    ).trim()

                    // Tag is independent of the backend pipeline's tag; rollback
                    // looks up xiaoan-ui tags only.
                    env.IMAGE_TAG = "${params.DEPLOY_ENV}-${new Date().format('yyyyMMddHHmmss')}-${env.GIT_SHORT_SHA}"
                }
                echo "IMAGE_TAG=${env.IMAGE_TAG}"
            }
        }

        stage('编译前端') {
            steps {
                sh '''
                    source /etc/profile

                    # npm ci for reproducible installs
                    nodedkbuild "$WORKSPACE/frontend" \
                      "node22140" \
                      "npm ci"

                    # Build with the environment's K8s upstream service names baked
                    # into nginx.generated.conf.
                    nodedkbuild "$WORKSPACE/frontend" \
                      "node22140" \
                      "APP_BASE_PATH=/xiaoan-platform/ NGINX_API_UPSTREAM=${API_UPSTREAM} NGINX_STREAM_UPSTREAM=${STREAM_UPSTREAM} npm run build"

                    if [ ! -d "$WORKSPACE/frontend/dist" ]; then
                        echo "前端编译失败"
                        exit 1
                    fi

                    if [ ! -f "$WORKSPACE/frontend/nginx.generated.conf" ]; then
                        echo "nginx.generated.conf 未生成，部署脚本未执行"
                        exit 1
                    fi
                '''
            }
        }

        stage('构建前端镜像') {
            steps {
                sh '''
                    docker build \
                      -f frontend/Dockerfile \
                      -t ${HARBOR}/${HARBOR_PROJECT}/xiaoan-ui:${IMAGE_TAG} \
                      frontend
                '''
            }
        }

        stage('推送镜像') {
            steps {
                sh '''
                    docker push ${HARBOR}/${HARBOR_PROJECT}/xiaoan-ui:${IMAGE_TAG}
                '''
            }
        }

        stage('更新 K8s') {
            when { expression { return !params.SKIP_DEPLOY } }
            steps {
                sh '''
                    kubectl -n ${NAMESPACE} set image \
                      deployment/xiaoan-ui${SUFFIX} \
                      xiaoan-ui${SUFFIX}=${HARBOR}/${HARBOR_PROJECT}/xiaoan-ui:${IMAGE_TAG}
                '''
            }
        }

        stage('检查发布状态') {
            when { expression { return !params.SKIP_DEPLOY } }
            steps {
                sh '''
                    kubectl rollout status deployment/xiaoan-ui${SUFFIX} -n ${NAMESPACE} --timeout=180s
                '''
            }
        }
    }
}
