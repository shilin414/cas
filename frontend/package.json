{
  "name": "xiaoan-platform",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "tsc && vite build && node scripts/deployment.mjs",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:deployment": "node --test scripts/deployment.test.mjs scripts/deployment-proxy.test.mjs",
    "check:tokens": "node scripts/check-css-tokens.mjs",
    "ocr:runtime": "node scripts/prepare-ocr-runtime.mjs",
    "ocr:prepare": "node scripts/prepare-ocr-resources.mjs",
    "predev": "npm run ocr:runtime",
    "prebuild": "npm run ocr:runtime && npm run ocr:prepare",
    "test:ocr-deployment": "node --test scripts/ocr-deployment.test.mjs"
  },
  "dependencies": {
    "@ant-design/icons": "^5.6.1",
    "@paddleocr/paddleocr-js": "0.4.2",
    "@techstark/opencv-js": "4.10.0-release.1",
    "antd": "^5.29.3",
    "axios": "^1.18.0",
    "onnxruntime-web": "1.22.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.2",
    "remark-gfm": "^4.0.1",
    "sass": "^1.100.0",
    "zustand": "^4.5.7"
  },
  "devDependencies": {
    "@tailwindcss/forms": "^0.5.11",
    "@types/node": "^25.9.2",
    "@types/react": "^18.2.56",
    "@types/react-dom": "^18.2.19",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "@vitejs/plugin-react": "^5.2.0",
    "autoprefixer": "^10.5.0",
    "esbuild": "^0.28.1",
    "eslint": "^8.56.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "jsdom": "^30.0.1",
    "postcss": "^8.5.23",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.3.3",
    "vite": "^7.3.6",
    "vitest": "^4.1.10"
  }
}
