// xiaoan-platform BACKEND pipeline — TEST environment, hard-wired.
// One pipeline file per environment (Jenkinsfile.backend for prod);
// the Jenkins job picks its environment by its Script Path, no parameters
// to choose from.
//
// Flow: GitLab(test branch) → docker build xiaoan-backend → Harbor(eboat2) →
// set image on 5 test Deployments (test-ai-ns, -test suffix) → rollout check.
// Tag prefix test-; rollback looks up test- tags only.
//
// NEVER runs database migrations (manual ops step, k8s/README.md §四) and never
// creates Namespace/Secret/ConfigMap — one-time kubectl applies.
//
// This pipeline does NOT build the frontend: no Node stage, no nodedkbuild.

pipeline {
    agent any

    // SKIP_DEPLOY=true: build & push image only, do not touch K8s.
    parameters {
        booleanParam(name: 'SKIP_DEPLOY', defaultValue: false, description: '只构建并推送镜像，不更新 K8s')
    }

    environment {
        HARBOR          = 'harbor.hengan.com:8086'
        HARBOR_PROJECT  = 'eboat2'
        NAMESPACE       = 'test-ai-ns'
        TAG_PREFIX      = 'test'
        GIT_CREDENTIAL_ID = 'xiaoan-gitlab-http'
    }

    stages {

        stage('下载代码') {
            steps {
                git branch: 'test',
                    credentialsId: "${GIT_CREDENTIAL_ID}",
                    url: 'http://192.168.0.81/ai_sys/xiaoan-platform.git'
            }
        }

        stage('准备版本号') {
            steps {
                script {
                    env.GIT_SHORT_SHA = sh(
                        script: 'git rev-parse --short=8 HEAD',
                        returnStdout: true
                    ).trim()

                    env.IMAGE_TAG = "${TAG_PREFIX}-${new Date().format('yyyyMMddHHmmss')}-${env.GIT_SHORT_SHA}"
                }
                echo "IMAGE_TAG=${env.IMAGE_TAG}"
            }
        }

        stage('构建后端镜像') {
            steps {
                sh '''
                    docker build \
                      -f backend-go/Dockerfile \
                      -t ${HARBOR}/${HARBOR_PROJECT}/xiaoan-backend:${IMAGE_TAG} \
                      backend-go
                '''
            }
        }

        stage('推送镜像') {
            steps {
                sh '''
                    docker push ${HARBOR}/${HARBOR_PROJECT}/xiaoan-backend:${IMAGE_TAG}
                '''
            }
        }

        stage('更新 K8s') {
            when { expression { return !params.SKIP_DEPLOY } }
            steps {
                sh '''
                    kubectl -n ${NAMESPACE} set image \
                      deployment/xiaoan-api-test \
                      xiaoan-api-test=${HARBOR}/${HARBOR_PROJECT}/xiaoan-backend:${IMAGE_TAG}

                    kubectl -n ${NAMESPACE} set image \
                      deployment/xiaoan-stream-test \
                      xiaoan-stream-test=${HARBOR}/${HARBOR_PROJECT}/xiaoan-backend:${IMAGE_TAG}

                    kubectl -n ${NAMESPACE} set image \
                      deployment/xiaoan-worker-aily-test \
                      xiaoan-worker-aily-test=${HARBOR}/${HARBOR_PROJECT}/xiaoan-backend:${IMAGE_TAG}

                    kubectl -n ${NAMESPACE} set image \
                      deployment/xiaoan-worker-delivery-test \
                      xiaoan-worker-delivery-test=${HARBOR}/${HARBOR_PROJECT}/xiaoan-backend:${IMAGE_TAG}

                    kubectl -n ${NAMESPACE} set image \
                      deployment/xiaoan-scheduler-test \
                      xiaoan-scheduler-test=${HARBOR}/${HARBOR_PROJECT}/xiaoan-backend:${IMAGE_TAG}
                '''
            }
        }

        stage('检查发布状态') {
            when { expression { return !params.SKIP_DEPLOY } }
            steps {
                sh '''
                    set -e

                    kubectl rollout status deployment/xiaoan-api-test -n ${NAMESPACE} --timeout=180s
                    kubectl rollout status deployment/xiaoan-stream-test -n ${NAMESPACE} --timeout=180s
                    kubectl rollout status deployment/xiaoan-worker-aily-test -n ${NAMESPACE} --timeout=180s
                    kubectl rollout status deployment/xiaoan-worker-delivery-test -n ${NAMESPACE} --timeout=180s
                    kubectl rollout status deployment/xiaoan-scheduler-test -n ${NAMESPACE} --timeout=180s
                '''
            }
        }
    }
}
